# Copy to .env.local for local development. Add the same names in
# Vercel > Settings > Environment Variables. Never commit real values.

# Which model provider to use: gemini (the default) or anthropic.
LLM_PROVIDER=gemini

# Gemini API key, from aistudio.google.com. Required for LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional. Overrides the model. The default, gemini-2.5-flash, is the only
# Flash text model with Google Search on the free tier.
GEMINI_MODEL=

# Optional. Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Upstash Redis. Vercel's Marketplace integration adds these for you. If your
# store gives you KV_REST_API_URL and KV_REST_API_TOKEN instead, those work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
