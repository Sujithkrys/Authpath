# Copy to .env.local for local development. Add the same names in
# Vercel > Settings > Environment Variables. Never commit real values.

# Which model provider to use: gemini (the default) or anthropic.
LLM_PROVIDER=gemini

# Gemini API key, from aistudio.google.com. Required for LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Optional, and never read in production. Local work and compare mode use this
# key instead, so testing can't use up the demo's quota. Google applies limits per
# project, not per key, so create it in a different Google Cloud project.
GEMINI_API_KEY_DEV=

# Optional. Overrides the model. By default it tries gemini-3.5-flash-lite, then
# gemini-3.5-flash, then gemini-3.6-flash. Setting this uses that one model alone.
GEMINI_MODEL=

# Optional. Set to true to use Google Search, for a key that has access to it.
# The free tier has no Search on Gemini 3 or newer, so this needs billing, or
# gemini-2.5-flash on an account Google still allows to use it.
GEMINI_SEARCH=

# Optional. Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Upstash Redis. Vercel's Marketplace integration adds these for you. If your
# store gives you KV_REST_API_URL and KV_REST_API_TOKEN instead, those work too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Generations allowed per IP per hour. Defaults to 20, so several
# reviewers on one office network can test at once.
RATE_LIMIT_PER_HOUR=

# Local development only. Set to true to allow {"compare": true} in /api/generate
# requests, which generates guides even for library apps (to check the agent
# against hand-verified guides) and skips the cache, the rate limit and saving.
# Ignored in production builds. Never set this in Vercel.
AUTHPATH_COMPARE=
